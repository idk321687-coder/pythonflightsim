<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#061017">
  <title>Skyline Vector | Cesium Flight Simulator</title>
  <link rel="stylesheet" href="https://cesium.com/downloads/cesiumjs/releases/1.146/Build/Cesium/Widgets/widgets.css">
  <script src="/static/cesium-config.js"></script>
  <script src="https://cesium.com/downloads/cesiumjs/releases/1.146/Build/Cesium/Cesium.js"></script>
  <style>
    :root { --ink: #e5fff0; --muted: #9cc8b1; --accent: #7df2b4; --edge: rgba(139,238,183,.22); --glass: rgba(3,16,23,.8); --warn: #ffd485; }
    * { box-sizing: border-box; } html,body,#cesiumContainer { width:100%; height:100%; margin:0; overflow:hidden; background:#061017; font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif; }
    .cesium-viewer-bottom { left:0!important; right:auto!important; } #hud { position:fixed; inset:0; z-index:5; pointer-events:none; color:var(--ink); letter-spacing:.06em; text-shadow:0 1px 8px #000; }
    .glass { background:linear-gradient(135deg,rgba(7,28,35,.86),var(--glass)); border:1px solid var(--edge); box-shadow:0 14px 38px rgba(0,0,0,.25),inset 0 0 28px rgba(66,196,145,.035); backdrop-filter:blur(9px); }
    .brand { position:absolute; top:24px; left:26px; display:flex; align-items:center; gap:11px; }.mark { width:27px; height:27px; border:2px solid var(--accent); transform:rotate(45deg); box-shadow:0 0 15px rgba(125,242,180,.4); }.brand b { display:block; font-size:13px; letter-spacing:.2em; }.brand span,.eyebrow { color:var(--muted); font-size:8px; letter-spacing:.15em; }
    #flight-panel { position:absolute; top:24px; right:26px; width:242px; padding:14px 15px; }.flight-name { margin:5px 0 10px; color:#fff; font-weight:800; font-size:12px; letter-spacing:.1em; }.state-line { display:flex; justify-content:space-between; font:10px/1.8 "Cascadia Mono",ui-monospace,monospace; color:#b8e7ca; }.state-line b { color:#fff; font-weight:700; }
    #readouts { position:absolute; left:26px; bottom:28px; display:grid; grid-template-columns:repeat(2,128px); overflow:hidden; }.readout { min-height:61px; padding:10px 12px; border-right:1px solid var(--edge); border-bottom:1px solid var(--edge); }.readout:nth-child(2n) { border-right:0; }.readout:nth-child(n+3) { border-bottom:0; }.readout span { display:block; }.readout-label { color:var(--muted); font-size:8px; }.readout-value { margin-top:4px; color:#fff; font:650 20px/1 "Cascadia Mono",ui-monospace,monospace; letter-spacing:-.05em; }.unit { color:var(--muted); font-size:8px; }
    #command-panel { position:absolute; top:139px; right:26px; width:242px; pointer-events:auto; } #airport-search { display:flex; margin-bottom:8px; } input { min-width:0; width:100%; padding:9px 10px; color:#ecfff3; background:rgba(2,12,18,.88); border:1px solid var(--edge); outline:0; font:10px "Cascadia Mono",ui-monospace,monospace; letter-spacing:.04em; } input:focus { border-color:var(--accent); } button { border:1px solid var(--edge); color:#c7f2d5; background:rgba(4,22,29,.85); padding:8px 10px; font:700 8px Inter,sans-serif; letter-spacing:.1em; cursor:pointer; } button:hover,button.active { color:#06130e; background:var(--accent); } #airport-search button { border-left:0; }.grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; }.grid button:last-child { grid-column:span 2; } #search-results { max-height:205px; margin-top:8px; overflow:auto; }.result { width:100%; margin-top:4px; padding:8px 9px; text-align:left; font-size:8px; }.result strong { display:block; color:#fff; font-size:9px; margin-bottom:3px; }.result em { color:var(--muted); font-style:normal; }
    #status { position:absolute; bottom:28px; right:26px; width:242px; padding:12px 14px; color:#bfead0; font:9px/1.5 "Cascadia Mono",ui-monospace,monospace; }.dot { display:inline-block; width:7px; height:7px; margin-right:7px; border-radius:50%; background:var(--accent); box-shadow:0 0 9px var(--accent); }.warning .dot { background:var(--warn); box-shadow:0 0 9px var(--warn); } #tip { position:absolute; top:25px; left:50%; transform:translateX(-50%); color:rgba(232,255,240,.9); text-align:center; font-size:9px; line-height:1.7; }.key { color:var(--accent); } #toast { position:absolute; top:17%; left:50%; transform:translate(-50%,-12px); opacity:0; transition:opacity .2s,transform .2s; color:#f1fff5; font-size:11px; font-weight:800; letter-spacing:.15em; white-space:nowrap; }.show { opacity:1!important; transform:translate(-50%,0)!important; }
    #loading { position:fixed; z-index:15; inset:0; display:grid; place-items:center; color:#ddffea; background:#061017; font-size:11px; font-weight:800; letter-spacing:.18em; transition:opacity .5s; }.loading-detail { display:block; margin-top:9px; color:var(--muted); font-size:8px; font-weight:500; text-align:center; } #welcome { position:absolute; left:50%; top:50%; width:min(420px,calc(100vw - 36px)); padding:23px; transform:translate(-50%,-50%); text-align:center; pointer-events:auto; transition:opacity .25s; }.hidden { opacity:0; pointer-events:none; }.hidden * { pointer-events:none; } #welcome h1 { margin:7px 0 11px; color:#fff; font-size:clamp(25px,4vw,37px); letter-spacing:.14em; }.welcome-copy { margin:0 0 18px; color:#c1e8d0; font-size:11px; line-height:1.7; letter-spacing:.03em; }.welcome-note { margin:11px 0 0; color:var(--muted); font-size:8px; line-height:1.5; } #begin { padding:10px 18px; color:#06170e; background:var(--accent); border:0; }
    @media(max-width:760px) { .brand { left:15px; top:14px; }.brand span { display:none; } #flight-panel { right:15px; top:14px; width:170px; padding:9px; }.flight-name { font-size:9px; } #command-panel { display:none; } #readouts { left:15px; bottom:15px; grid-template-columns:repeat(2,96px); }.readout { min-height:52px; padding:8px; }.readout-value { font-size:15px; } #status { display:none; } #tip { top:83px; width:240px; } }
  </style>
</head>
<body>
  <div id="cesiumContainer" aria-label="3D world flight simulator"></div>
  <div id="loading">INITIALIZING WORLD<span class="loading-detail">loading Cesium, local aircraft and botanical assets</span></div>
  <main id="hud">
    <div class="brand"><i class="mark"></i><div><b>SKYLINE VECTOR</b><span>GLOBAL CESIUM FLIGHT RANGE</span></div></div>
    <section id="flight-panel" class="glass"><div class="eyebrow">ACTIVE AIRCRAFT</div><div id="aircraft-name" class="flight-name">LOADING MODEL CATALOG</div><div class="state-line"><span>IMAGERY</span><b id="biome-readout">ESRI SATELLITE</b></div><div class="state-line"><span>AIRPORTS IN VIEW</span><b id="airport-count">—</b></div><div class="state-line"><span>MAPPED VEGETATION</span><b id="foliage-count">—</b></div><div class="state-line"><span>GRASS TUFTS</span><b id="grass-count">—</b></div><div class="state-line"><span>3D BUILDINGS</span><b id="building-count">—</b></div></section>
    <section id="readouts" class="glass"><div class="readout"><span class="readout-label">AIRSPEED</span><span class="readout-value" id="speed">000</span><span class="unit"> KTS</span></div><div class="readout"><span class="readout-label">ALTITUDE</span><span class="readout-value" id="altitude">0000</span><span class="unit"> FT MSL</span></div><div class="readout"><span class="readout-label">HEADING</span><span class="readout-value" id="heading">000</span><span class="unit"> DEG</span></div><div class="readout"><span class="readout-label">VERTICAL SPEED</span><span class="readout-value" id="vspeed">+000</span><span class="unit"> FPM</span></div></section>
    <section id="command-panel" class="glass"><form id="airport-search"><input id="airport-query" autocomplete="off" placeholder="ICAO, IATA, airport or city"><button>FIND</button></form><div class="grid"><button id="follow" class="active">CAMERA: CHASE</button><button id="regrow">LOAD REAL SCENE</button><button id="buildings" class="active">3D BUILDINGS: ON</button><button id="airports">REFRESH AIRPORTS</button><button id="pause">PAUSE FLIGHT</button></div><div id="search-results"></div></section>
    <section id="status" class="glass"><div id="status-main"><i class="dot"></i>BOOTING LOCAL TELEMETRY</div><div id="status-detail">Airport index and local model catalog are loading.</div></section>
    <div id="tip"><span class="key">ARROWS / A D</span> PITCH / BANK &nbsp; <span class="key">W / S</span> THROTTLE &nbsp; <span class="key">P</span> PAUSE<br><span class="key">C</span> CAMERA MODE &nbsp; <span class="key">R</span> REGROW BIOME</div><div id="toast"></div>
    <section id="welcome" class="glass"><div class="eyebrow">WORLD FLIGHT / MAPPED LOCAL SCENE</div><h1>SKYLINE VECTOR</h1><p class="welcome-copy">Fly a local GLB aircraft over satellite imagery. Trees, shrubs, rocks, water footprints, and building footprints load from their mapped OpenStreetMap coordinates around each destination; they are not randomly scattered.</p><button id="begin">BEGIN FLIGHT</button><p class="welcome-note" id="terrain-note">A Cesium ion browser token additionally enables World Terrain, terrain water masks, and globally streamed Cesium OSM Buildings.</p></section>
  </main>
  <script>
  (async () => {
    'use strict';
    const $ = (id) => document.getElementById(id); const ui = { loading:$('loading'),welcome:$('welcome'),toast:$('toast'),aircraft:$('aircraft-name'),biome:$('biome-readout'),airportCount:$('airport-count'),foliageCount:$('foliage-count'),grassCount:$('grass-count'),buildingCount:$('building-count'),speed:$('speed'),altitude:$('altitude'),heading:$('heading'),vspeed:$('vspeed'),statusMain:$('status-main'),statusDetail:$('status-detail'),results:$('search-results'),terrainNote:$('terrain-note') };
    let runtimeConfig={};try{const response=await fetch('/api/runtime-config',{cache:'no-store'});if(response.ok)runtimeConfig=await response.json();}catch(_){} const token=(runtimeConfig.cesiumIonToken||window.CESIUM_ION_TOKEN||'').trim(),hasIon=token.length>0;if(hasIon)Cesium.Ion.defaultAccessToken=token;
    const viewer=new Cesium.Viewer('cesiumContainer',{baseLayer:false,animation:false,timeline:false,geocoder:false,homeButton:false,sceneModePicker:false,navigationHelpButton:false,fullscreenButton:false,infoBox:false,selectionIndicator:false,shouldAnimate:true});
    viewer.imageryLayers.addImageryProvider(new Cesium.UrlTemplateImageryProvider({url:'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',credit:new Cesium.Credit('Tiles © Esri',true)})); viewer.scene.globe.enableLighting=hasIon; viewer.scene.globe.showGroundAtmosphere=true; viewer.scene.highDynamicRange=false; viewer.resolutionScale=Math.min(window.devicePixelRatio||1,1.25); viewer.camera.percentageChanged=.01;
    const escapeHtml=(value)=>String(value).replace(/[&<>'"]/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
    const setStatus=(title,detail,warning=false)=>{ui.statusMain.innerHTML=`<i class="dot"></i>${escapeHtml(title)}`;ui.statusMain.classList.toggle('warning',warning);ui.statusDetail.textContent=detail;};
    let ionBuildingsTileset=null; if(hasIon){try{const terrain=Cesium.Terrain.fromWorldTerrain({requestWaterMask:true,requestVertexNormals:true});viewer.scene.setTerrain(terrain);terrain.readyEvent.addEventListener(()=>setStatus('WORLD TERRAIN + WATER MASKS ACTIVE','Cesium ion terrain lighting and water effects are enabled.'));terrain.errorEvent.addEventListener(()=>setStatus('TERRAIN FALLBACK','World Terrain was unavailable; the globe remains flyable.',true));Cesium.createOsmBuildingsAsync({scene:viewer.scene}).then((tiles)=>{ionBuildingsTileset=viewer.scene.primitives.add(tiles);if(buildingsVisible)buildingSource.show=false;ui.buildingCount.textContent='GLOBAL';}).catch(()=>{});ui.terrainNote.textContent='World Terrain, terrain lighting, water masks, and globally streamed OSM Buildings are enabled for this session.';}catch(_){setStatus('TERRAIN FALLBACK','Unable to initialize World Terrain.',true);}}else{ui.terrainNote.textContent='Esri satellite imagery and mapped OSM scene data are active. Add an ion browser token for World Terrain, terrain water masks, and global Cesium OSM Buildings.';}
    const airportSource=new Cesium.CustomDataSource('world-airports'),foliageSource=new Cesium.CustomDataSource('mapped-vegetation'),grassSource=new Cesium.CustomDataSource('mapped-grass'),buildingSource=new Cesium.CustomDataSource('mapped-buildings'),waterSource=new Cesium.CustomDataSource('mapped-water');viewer.dataSources.add(airportSource);viewer.dataSources.add(foliageSource);viewer.dataSources.add(grassSource);viewer.dataSources.add(buildingSource);viewer.dataSources.add(waterSource);
    const keys=new Set(),flight={lat:47.4489,lon:-122.3094,altitude:740,speed:71,throttle:.62,heading:0,pitch:.025,bank:0,verticalSpeed:0,paused:true,started:false,follow:true}; let catalog=null,aircraft=null,aircraftRecord=null,airportRequest=0,airportTimer=0,toastTimer=0,lastFrame=performance.now(),lastTelemetry=0,buildingsVisible=true; const clamp=(n,low,high)=>Math.max(low,Math.min(high,n)),degrees=Cesium.Math.toDegrees,radians=Cesium.Math.toRadians;
    const showToast=(message)=>{ui.toast.textContent=message;ui.toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>ui.toast.classList.remove('show'),2600);}; const formatAirport=(airport)=>`${airport.ident}${airport.iata?` / ${airport.iata}`:''} — ${airport.name}`;
    function flightPosition(){return Cesium.Cartesian3.fromDegrees(flight.lon,flight.lat,flight.altitude);} function flightOrientation(){return Cesium.Transforms.headingPitchRollQuaternion(flightPosition(),new Cesium.HeadingPitchRoll(Math.PI/2-flight.heading,flight.pitch,-flight.bank));} function updatePlane(){if(!aircraft)return;aircraft.position=flightPosition();aircraft.orientation=flightOrientation();}
    function updateHud(){const knots=Math.round(flight.speed*1.94384),feet=Math.max(0,Math.round(flight.altitude*3.28084));ui.speed.textContent=String(knots).padStart(3,'0');ui.altitude.textContent=String(feet).padStart(4,'0');ui.heading.textContent=String(Math.round((degrees(flight.heading)+360)%360)).padStart(3,'0');ui.vspeed.textContent=`${flight.verticalSpeed>=0?'+':''}${Math.round(flight.verticalSpeed*196.85)}`;ui.biome.textContent='ESRI SATELLITE';}
    function updateFlight(dt){if(!flight.started||flight.paused)return;const rollInput=(keys.has('ArrowRight')?1:0)-(keys.has('ArrowLeft')?1:0),pitchInput=(keys.has('ArrowUp')?1:0)-(keys.has('ArrowDown')?1:0),throttleInput=(keys.has('KeyW')?1:0)-(keys.has('KeyS')?1:0);flight.throttle=clamp(flight.throttle+throttleInput*dt*.25,0,1);flight.bank=clamp(flight.bank+rollInput*dt*1.05-flight.bank*dt*.42,-1.05,1.05);flight.pitch=clamp(flight.pitch+pitchInput*dt*.45-flight.pitch*dt*.21,-.39,.39);const targetSpeed=31+flight.throttle*113;flight.speed=clamp(flight.speed+(targetSpeed-flight.speed)*dt*.31-Math.abs(flight.bank)*flight.speed*dt*.012,28,145);const desiredVerticalSpeed=Math.sin(flight.pitch)*flight.speed*.74;flight.verticalSpeed+=(desiredVerticalSpeed-flight.verticalSpeed)*Math.min(1,dt*3.1);flight.altitude=Math.max(60,flight.altitude+flight.verticalSpeed*dt);flight.heading=(flight.heading+Math.sin(flight.bank)*(flight.speed/103)*dt+Math.PI*2)%(Math.PI*2);const north=Math.cos(flight.heading)*flight.speed*dt,east=Math.sin(flight.heading)*flight.speed*dt;flight.lat=clamp(flight.lat+north/111320,-85,85);flight.lon+=east/(111320*Math.max(.08,Math.cos(radians(flight.lat))));if(flight.lon>180)flight.lon-=360;if(flight.lon<-180)flight.lon+=360;updatePlane();updateHud();}
    function beginFlight(){flight.started=true;flight.paused=false;ui.welcome.classList.add('hidden');$('pause').textContent='PAUSE FLIGHT';setFollow(true);showToast('CLEARED FOR WORLD FLIGHT');} function togglePause(){if(!flight.started)return beginFlight();flight.paused=!flight.paused;$('pause').textContent=flight.paused?'RESUME FLIGHT':'PAUSE FLIGHT';showToast(flight.paused?'FLIGHT PAUSED':'FLIGHT RESUMED');} function setFollow(enabled){flight.follow=enabled;viewer.trackedEntity=enabled?aircraft:undefined;$('follow').classList.toggle('active',enabled);$('follow').textContent=enabled?'CAMERA: CHASE':'CAMERA: FREE';} function resetView(){viewer.camera.flyTo({destination:Cesium.Cartesian3.fromDegrees(flight.lon,flight.lat,Math.max(1800,flight.altitude+1000)),orientation:{heading:Math.PI/2-flight.heading,pitch:radians(-23),roll:0},duration:1.2});}
    function waterMaterial(){return new Cesium.Material({fabric:{type:'Water',uniforms:{normalMap:Cesium.buildModuleUrl('Assets/Textures/waterNormals.jpg'),frequency:650,animationSpeed:.012,amplitude:5,specularIntensity:.75,baseWaterColor:new Cesium.Color(.02,.18,.24,.73),blendColor:new Cesium.Color(.04,.48,.55,.45)}}});}
    function stablePick(models,key){let value=2166136261;for(const char of String(key))value=Math.imul(value^char.charCodeAt(0),16777619);return models[Math.abs(value) % models.length];} function treeModelFor(item){const all=catalog.foliage,text=`${item.genus||''} ${item.species||''} ${item.leaf_type||''} ${item.leaf_cycle||''}`.toLowerCase(),byId=(id)=>all.find((model)=>model.id===id),pick=(ids)=>stablePick(ids.map(byId).filter(Boolean),item.id);if(item.kind==='shrub')return stablePick(all.filter((model)=>model.category==='bush'&&model.subtype!=='grass'),item.id);if(item.kind==='rock')return stablePick(all.filter((model)=>model.category==='rock'),item.id);if(/palm|arecaceae/.test(text))return byId('palm_tropical');if(/salix|willow/.test(text))return byId('weeping_willow');if(/acer|maple/.test(text))return byId('oak_broadleaf');if(/betula|birch/.test(text))return byId('birch_cluster');if(/sequoia|redwood/.test(text))return byId('giant_redwood');if(/pinus|picea|abies|conifer|needle/.test(text))return pick(['web_tree_1','web_tree_3','pine_tall','giant_redwood']);return pick(['web_tree_2','web_tree_4','oak_broadleaf','birch_cluster']);}
    function pointScale(item,model){const mappedHeight=Number(item.height_m)||model.target_size_m;return clamp(model.base_scale*(mappedHeight/model.target_size_m),model.base_scale*.3,model.base_scale*2.8);}
    function footprintPositions(footprint){return Cesium.Cartesian3.fromDegreesArray(footprint.flat());} function pointInsidePolygon(point,polygon){let inside=false;for(let i=0,j=polygon.length-1;i<polygon.length;j=i++){const a=polygon[i],b=polygon[j],cross=(a[1]>point[1])!==(b[1]>point[1])&&point[0]<(b[0]-a[0])*(point[1]-a[1])/(b[1]-a[1])+a[0];if(cross)inside=!inside;}return inside;} function polygonPlacements(area,areaPerInstance,min,max){const bounds=area.footprint.reduce((box,[lon,lat])=>({west:Math.min(box.west,lon),east:Math.max(box.east,lon),south:Math.min(box.south,lat),north:Math.max(box.north,lat)}),{west:Infinity,east:-Infinity,south:Infinity,north:-Infinity}),latitude=(bounds.south+bounds.north)/2,areaM2=Math.abs(area.footprint.reduce((sum,[lon,lat],i)=>{const next=area.footprint[(i+1)%area.footprint.length];return sum+(lon*next[1]-next[0]*lat);},0))*0.5*111320*111320*Math.cos(radians(latitude)),wanted=clamp(Math.round(areaM2/areaPerInstance),min,max),positions=[];let seed=0;for(const char of area.id)seed=(Math.imul(seed,31)+char.charCodeAt(0))>>>0;const random=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296;};for(let attempt=0;attempt<wanted*9&&positions.length<wanted;attempt++){const point=[bounds.west+(bounds.east-bounds.west)*random(),bounds.south+(bounds.north-bounds.south)*random()];if(pointInsidePolygon(point,area.footprint))positions.push({lon:point[0],lat:point[1],scale:.68+random()*.52,heading:random()*Math.PI*2});}return positions;} function grassPlacements(area){return polygonPlacements(area,130,10,95);} function forestPlacements(area){return polygonPlacements(area,360,6,80);}
    async function loadRealWorldScene(fresh=false){try{setStatus('LOADING MAPPED WORLD SCENE','Requesting real OSM vegetation, forest canopy, grass, water, and building footprints around the aircraft.');const query=new URLSearchParams({lat:flight.lat.toFixed(6),lon:flight.lon.toFixed(6),radius_m:'700',fresh:String(fresh)}),response=await fetch(`/api/real-world-scene?${query}`);if(!response.ok)throw Error();const scene=await response.json(),grassModel=catalog.foliage.find((model)=>model.id==='grass_tuft');foliageSource.entities.removeAll();grassSource.entities.removeAll();buildingSource.entities.removeAll();waterSource.entities.removeAll();let treeCount=0,esaKept=0;for(const item of scene.vegetation){if(item.source==='esa_worldcover_2021_tree_cover'){const dm=Math.hypot((item.lat-flight.lat)*111320,(item.lon-flight.lon)*111320*Math.cos(radians(flight.lat)));if(esaKept>=900||dm>450)continue;esaKept++;}const model=treeModelFor(item);if(!model)continue;foliageSource.entities.add({id:item.id,name:item.species||item.genus||`Mapped ${item.kind}`,position:Cesium.Cartesian3.fromDegrees(item.lon,item.lat,0),model:{uri:model.url,scale:pointScale(item,model),minimumPixelSize:1.5,maximumScale:180,heightReference:Cesium.HeightReference.RELATIVE_TO_GROUND,distanceDisplayCondition:new Cesium.DistanceDisplayCondition(0,item.source==='esa_worldcover_2021_tree_cover'?1500:10000)}});treeCount++;}for(const area of scene.forest){for(const point of forestPlacements(area)){if(treeCount>=2500)break;const model=treeModelFor({id:`${area.id}-${treeCount}`,kind:'tree'});foliageSource.entities.add({id:`${area.id}-${treeCount}`,name:'Tree in mapped forest canopy',position:Cesium.Cartesian3.fromDegrees(point.lon,point.lat,0),orientation:Cesium.Transforms.headingPitchRollQuaternion(Cesium.Cartesian3.fromDegrees(point.lon,point.lat,0),new Cesium.HeadingPitchRoll(point.heading,0,0)),model:{uri:model.url,scale:model.base_scale*point.scale,minimumPixelSize:2,maximumScale:175,heightReference:Cesium.HeightReference.RELATIVE_TO_GROUND,distanceDisplayCondition:new Cesium.DistanceDisplayCondition(0,8500)}});treeCount++;}if(treeCount>=2500)break;}let grassCount=0;if(grassModel){for(const area of scene.grass){for(const point of grassPlacements(area)){if(grassCount>=750)break;grassSource.entities.add({id:`${area.id}-${grassCount}`,name:'Mapped grass tuft',position:Cesium.Cartesian3.fromDegrees(point.lon,point.lat,0),orientation:Cesium.Transforms.headingPitchRollQuaternion(Cesium.Cartesian3.fromDegrees(point.lon,point.lat,0),new Cesium.HeadingPitchRoll(point.heading,0,0)),model:{uri:grassModel.url,scale:grassModel.base_scale*point.scale,minimumPixelSize:1,maximumScale:22,heightReference:Cesium.HeightReference.RELATIVE_TO_GROUND,distanceDisplayCondition:new Cesium.DistanceDisplayCondition(0,3200)}});grassCount++;}if(grassCount>=750)break;}}for(const item of scene.buildings){buildingSource.entities.add({id:item.id,name:item.name,polygon:{hierarchy:footprintPositions(item.footprint),height:0,extrudedHeight:item.height_m,perPositionHeight:false,heightReference:Cesium.HeightReference.CLAMP_TO_GROUND,extrudedHeightReference:Cesium.HeightReference.RELATIVE_TO_GROUND,material:Cesium.Color.fromCssColorString('#8ca4ae').withAlpha(.72),outline:false}});}for(const item of scene.water){waterSource.entities.add({id:item.id,name:item.name,polygon:{hierarchy:footprintPositions(item.footprint),height:0,material:waterMaterial(),outline:false}});}ui.foliageCount.textContent=treeCount.toLocaleString();ui.grassCount.textContent=grassCount.toLocaleString();if(!ionBuildingsTileset)ui.buildingCount.textContent=scene.buildings.length.toLocaleString();setStatus('MAPPED WORLD SCENE READY',`${scene.vegetation.length.toLocaleString()} exact points plus ${Math.max(0,treeCount-scene.vegetation.length).toLocaleString()} custom GLB trees inside ${scene.forest.length.toLocaleString()} mapped forest zones; ${grassCount.toLocaleString()} grass tufts sit inside mapped grass areas.`);showToast('REAL-WORLD SCENE LOADED');}catch(_){ui.foliageCount.textContent='UNAVAILABLE';ui.grassCount.textContent='UNAVAILABLE';ui.buildingCount.textContent='UNAVAILABLE';setStatus('MAPPED SCENE UNAVAILABLE','OpenStreetMap scene data could not be reached; no procedural foliage was substituted.',true);}}
    function airportColor(type){return type==='large_airport'?Cesium.Color.fromCssColorString('#ffdc86'):type==='medium_airport'?Cesium.Color.fromCssColorString('#8ff5bf'):type==='seaplane_base'?Cesium.Color.fromCssColorString('#72dfff'):Cesium.Color.fromCssColorString('#c7e6d2');} async function refreshAirports(force=false){const rectangle=viewer.camera.computeViewRectangle(viewer.scene.globe.ellipsoid);if(!rectangle)return;const width=degrees(rectangle.east>=rectangle.west?rectangle.east-rectangle.west:Math.PI*2-(rectangle.west-rectangle.east)),height=degrees(rectangle.north-rectangle.south);if(!force&&width>155&&height>75){airportSource.entities.removeAll();ui.airportCount.textContent='ZOOM IN';return;}const requestId=++airportRequest;try{const params=new URLSearchParams({west:degrees(rectangle.west).toFixed(5),south:degrees(rectangle.south).toFixed(5),east:degrees(rectangle.east).toFixed(5),north:degrees(rectangle.north).toFixed(5),limit:width>50?'750':'1800'}),response=await fetch(`/api/airports?${params}`);if(!response.ok)throw Error();const data=await response.json();if(requestId!==airportRequest)return;airportSource.entities.removeAll();const labelLimit=width<14?100:30;let labels=0;for(const airport of data.airports){const showLabel=labels<labelLimit&&(airport.type==='large_airport'||airport.type==='medium_airport');if(showLabel)labels++;airportSource.entities.add({id:`airport-${airport.ident}-${airport.lat}-${airport.lon}`,name:formatAirport(airport),position:Cesium.Cartesian3.fromDegrees(airport.lon,airport.lat,0),point:{pixelSize:airport.type==='large_airport'?8:airport.type==='medium_airport'?6:4,color:airportColor(airport.type),outlineColor:Cesium.Color.BLACK,outlineWidth:1,heightReference:Cesium.HeightReference.CLAMP_TO_GROUND,distanceDisplayCondition:new Cesium.DistanceDisplayCondition(0,1800000)},label:showLabel?{text:airport.ident,font:'10px monospace',fillColor:Cesium.Color.WHITE,outlineColor:Cesium.Color.BLACK,outlineWidth:3,style:Cesium.LabelStyle.FILL_AND_OUTLINE,pixelOffset:new Cesium.Cartesian2(7,-7),distanceDisplayCondition:new Cesium.DistanceDisplayCondition(0,850000)}:undefined,properties:{airport}});}ui.airportCount.textContent=data.airports.length.toLocaleString();}catch(_){ui.airportCount.textContent='OFFLINE';setStatus('AIRPORT INDEX OFFLINE','Unable to read the bundled global airport dataset.',true);}}
    async function searchAirports(query){if(!query.trim())return;ui.results.innerHTML='';try{const response=await fetch(`/api/airports/search?query=${encodeURIComponent(query)}`);if(!response.ok)throw Error();const {airports}=await response.json(),needle=query.trim().toUpperCase();if(!airports.length){ui.results.innerHTML='<div class="result">No matching airports.</div>';return;}const exact=airports.find((airport)=>airport.ident===needle||airport.iata===needle);if(exact){jumpToAirport(exact);return;}for(const airport of airports){const button=document.createElement('button');button.className='result';button.innerHTML=`<strong>${escapeHtml(airport.ident)}${airport.iata?` / ${escapeHtml(airport.iata)}`:''}</strong><em>${escapeHtml(airport.name)} · ${escapeHtml(airport.country||airport.region||'WORLD')}</em>`;button.addEventListener('click',()=>jumpToAirport(airport));ui.results.append(button);}}catch(_){ui.results.innerHTML='<div class="result">Airport search is not available.</div>';}}
    function jumpToAirport(airport){flight.lat=airport.lat;flight.lon=airport.lon;flight.altitude=Math.max(420,((airport.elevation_ft||0)/3.28084)+420);flight.heading=0;flight.verticalSpeed=0;updatePlane();resetView();loadRealWorldScene();refreshAirports(true);ui.results.innerHTML='';showToast(`POSITIONED: ${airport.ident}`);if(flight.follow)setTimeout(()=>setFollow(true),1300);}
    async function loadCatalog(){const response=await fetch('/api/catalog');if(!response.ok)throw Error();catalog=await response.json();aircraftRecord=catalog.aircraft.find((item)=>item.id==='supersonic_jet')||catalog.aircraft[0];if(!aircraftRecord)throw Error();aircraft=viewer.entities.add({id:'player-aircraft',name:aircraftRecord.label,position:flightPosition(),orientation:flightOrientation(),viewFrom:new Cesium.Cartesian3(-150,-205,74),model:{uri:aircraftRecord.url,scale:aircraftRecord.base_scale,minimumPixelSize:48,maximumScale:240,runAnimations:true,incrementallyLoadTextures:true}});ui.aircraft.textContent=aircraftRecord.label.toUpperCase();updatePlane();updateHud();}
    function postTelemetry(now){if(!flight.started||now-lastTelemetry<125)return;lastTelemetry=now;fetch('/telemetry',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({roll_deg:degrees(flight.bank),pitch_deg:degrees(flight.pitch),yaw_deg:degrees(flight.heading),latitude_deg:flight.lat,longitude_deg:flight.lon,altitude_m:flight.altitude})}).catch(()=>{});} function startTelemetryStatus(){setStatus('PYTHON TELEMETRY ACTIVE','Flight state posts directly to the local FastAPI telemetry endpoint.');}
    function toggleBuildings(){buildingsVisible=!buildingsVisible;buildingSource.show=buildingsVisible;if(ionBuildingsTileset)ionBuildingsTileset.show=buildingsVisible;$('buildings').classList.toggle('active',buildingsVisible);$('buildings').textContent=`3D BUILDINGS: ${buildingsVisible?'ON':'OFF'}`;} $('begin').addEventListener('click',beginFlight);$('follow').addEventListener('click',()=>{setFollow(!flight.follow);if(!flight.follow)resetView();});$('regrow').addEventListener('click',()=>loadRealWorldScene(true));$('buildings').addEventListener('click',toggleBuildings);$('airports').addEventListener('click',()=>refreshAirports(true));$('pause').addEventListener('click',togglePause);$('airport-search').addEventListener('submit',(event)=>{event.preventDefault();searchAirports($('airport-query').value);});
    window.addEventListener('keydown',(event)=>{if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(event.code))event.preventDefault();keys.add(event.code);if(event.code==='KeyA')keys.add('ArrowLeft');if(event.code==='KeyD')keys.add('ArrowRight');if(!event.repeat&&event.code==='KeyP')togglePause();if(!event.repeat&&event.code==='KeyC')setFollow(!flight.follow);if(!event.repeat&&event.code==='KeyR')loadRealWorldScene(true);if(!flight.started&&(event.code==='Enter'||event.code==='Space'))beginFlight();},{capture:true});window.addEventListener('keyup',(event)=>{keys.delete(event.code);if(event.code==='KeyA')keys.delete('ArrowLeft');if(event.code==='KeyD')keys.delete('ArrowRight');},{capture:true});window.addEventListener('pointerdown',()=>window.focus(),{capture:true});window.addEventListener('blur',()=>keys.clear());viewer.camera.moveEnd.addEventListener(()=>{clearTimeout(airportTimer);airportTimer=setTimeout(()=>refreshAirports(),180);});viewer.clock.onTick.addEventListener(()=>{const now=performance.now(),dt=Math.min(.05,(now-lastFrame)/1000);lastFrame=now;updateFlight(dt);postTelemetry(now);});
    forestPlacements=(area)=>polygonPlacements(area,12,320,800);const populateRealWorldScene=loadRealWorldScene;loadRealWorldScene=async(...args)=>{await populateRealWorldScene(...args);const entities=foliageSource.entities.values.filter((entity)=>entity.model&&entity.position),date=Cesium.JulianDate.now(),cartographics=entities.map((entity)=>Cesium.Cartographic.fromCartesian(entity.position.getValue(date)));for(const entity of entities){entity.model.minimumPixelSize=8;entity.model.maximumScale=220;entity.model.distanceDisplayCondition=new Cesium.DistanceDisplayCondition(0,12000);}try{const terrain=viewer.scene.terrainProvider||viewer.terrainProvider,samples=await Cesium.sampleTerrainMostDetailed(terrain,cartographics);for(let index=0;index<entities.length;index++){const point=samples[index];entities[index].position=Cesium.Cartesian3.fromRadians(point.longitude,point.latitude,Math.max(0,point.height||0));entities[index].model.heightReference=Cesium.HeightReference.NONE;}}catch(_){for(const entity of entities)entity.model.heightReference=Cesium.HeightReference.CLAMP_TO_GROUND;}};(async()=>{try{await loadCatalog();await loadRealWorldScene();resetView();refreshAirports(true);startTelemetryStatus();ui.loading.style.opacity='0';setTimeout(()=>ui.loading.remove(),520);}catch(_){ui.loading.innerHTML='STARTUP ERROR<span class="loading-detail">Run the simulator through the local Python server so its model and world-data APIs are available.</span>';setStatus('STARTUP ERROR','The local API or model catalog could not be loaded.',true);}})();
    const sceneStatusLoader=loadRealWorldScene;loadRealWorldScene=async(...args)=>{await sceneStatusLoader(...args);ui.statusDetail.textContent=ui.statusDetail.textContent.replace('exact points','ESA WorldCover Tree Cover points');};
    let sceneCenter={lat:flight.lat,lon:flight.lon},sceneIsLoading=false;const sceneDistance=(from,to)=>Math.hypot((to.lat-from.lat)*111320,(to.lon-from.lon)*111320*Math.cos(radians(to.lat)));const streamedSceneLoader=loadRealWorldScene;loadRealWorldScene=async(...args)=>{sceneIsLoading=true;try{await streamedSceneLoader(...args);sceneCenter={lat:flight.lat,lon:flight.lon};}finally{sceneIsLoading=false;}};viewer.clock.onTick.addEventListener(()=>{if(flight.started&&!sceneIsLoading&&sceneDistance(sceneCenter,flight)>500)loadRealWorldScene();});
    const farTrees=viewer.scene.primitives.add(new Cesium.BillboardCollection({scene:viewer.scene}));const farTreeImage=(()=>{const c=document.createElement('canvas');c.width=64;c.height=80;const g=c.getContext('2d');g.fillStyle='#4a3a28';g.fillRect(29,56,6,22);for(const b of [[32,26,22,'#2f5d2a'],[22,38,16,'#3a6e32'],[42,38,16,'#2b5326'],[32,40,18,'#356a30']]){g.fillStyle=b[3];g.beginPath();g.arc(b[0],b[1],b[2],0,Math.PI*2);g.fill();}return c.toDataURL('image/png');})();let farCenter=null,farLoading=false;async function loadFarTrees(){if(farLoading)return;farLoading=true;farCenter={lat:flight.lat,lon:flight.lon};try{const q=new URLSearchParams({lat:flight.lat.toFixed(5),lon:flight.lon.toFixed(5),radius_m:'9000',max_points:'25000'});const r=await fetch(`/api/far-trees?${q}`);if(!r.ok)return;const data=await r.json(),pts=data.points||[];const flat=viewer.scene.terrainProvider instanceof Cesium.EllipsoidTerrainProvider,hr=flat?Cesium.HeightReference.NONE:Cesium.HeightReference.CLAMP_TO_GROUND,cosLat=Math.cos(radians(flight.lat));farTrees.removeAll();for(let i=0;i+1<pts.length;i+=2){const lon=pts[i],lat=pts[i+1];if(Math.hypot((lat-flight.lat)*111320,(lon-flight.lon)*111320*cosLat)<450)continue;farTrees.add({position:Cesium.Cartesian3.fromDegrees(lon,lat,0),image:farTreeImage,width:30,height:38,sizeInMeters:true,verticalOrigin:Cesium.VerticalOrigin.BOTTOM,heightReference:hr});}}catch(_){}finally{farLoading=false;}}viewer.clock.onTick.addEventListener(()=>{if(!farLoading&&(!farCenter||sceneDistance(farCenter,flight)>2000))loadFarTrees();});
  })();
  </script>
</body>
</html>
